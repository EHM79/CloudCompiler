# =======================================================
# CloudCode / CloudCompiler AI Environment Variables
# =======================================================

# Server port (defaults to 5000)
PORT=5000

# MongoDB Database Connection URL
DATABASE_URL=

# JWT Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Optional for local development. Leave unset for same-origin Vercel deployment.
CLIENT_ORIGIN=http://localhost:5000
# Set COOKIE_SECURE=true in production (Vercel HTTPS).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Judge0 CE (free public instance — no key required)
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# Google Gemini API (for AI Explain feature)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=